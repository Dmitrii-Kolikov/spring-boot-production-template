{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "javaType": "com.spring.boot.production.template.api.dto.rest.FeatureModelListRq",
  "description": "Запрос",
  "additionalProperties": true,
  "required": [
    "descriptions"
  ],
  "properties": {
    "descriptions": {
      "type": "array",
      "description": "Массив описаний встреч",
