        "type": "object",
        "description": "Данных об описании встречи",
        "additionalProperties": true,
        "required": [
          "description"
        ],
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "examples": ["Важная встреча с клиентом"],
            "description": "Описание встречи"
          }

        }
      }
    }
  }
}